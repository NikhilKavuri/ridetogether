<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A plain platform theme, not an AppCompat or Material Components one.

      The entire UI is Compose, which brings its own Material 3 theming in
      Kotlin. Pulling in the Material Components XML themes would add a
      dependency and a second, redundant source of truth for colour that could
      drift out of step with the Compose one. All this theme needs to do is
      avoid an action bar and paint the right colour behind the window while
      the first frame is composed.
    -->
    <style name="Theme.RideTogether" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
